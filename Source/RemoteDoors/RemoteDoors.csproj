<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>RemoteDoors</AssemblyName>
    <RootNamespace>RemoteDoors</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>

    <!-- Drop the DLL straight into the mod's versioned Assemblies folder. -->
    <OutputPath>$(MSBuildProjectDirectory)/../../1.6/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- .NET Framework targeting packs, so net472 builds on Linux/containers. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />

    <!-- RimWorld + Unity reference assemblies. Matches installed build 1.6.4871.
         PrivateAssets/ExcludeAssets keep them out of the output folder: shipping
         Assembly-CSharp.dll next to a mod DLL breaks the game on load. -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
